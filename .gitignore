# Claude Code machine-local state: MCP server approvals and per-user settings.
# Deliberately not shared — it records what this machine has consented to run.
.claude/settings.local.json

# Generated per machine by `amp-bridge init` (via `make setup`): it holds an
# absolute path to the installed binary, so a committed copy is broken for
# everyone else and drifts silently for you. See amp-bridge/init.go.
.mcp.json

# Build output. `make build` writes bin/amp-bridge; the source package is
# amp-bridge/, so the binary cannot share that name.
/bin/
/coverage.out

# Throwaway spike plugin (see .claude/research/2026-08-20-amp-bridge-inbox-plugin-plan.md H-1).
# The real plugin ships embedded in the binary and its installed copy IS committed.
.amp/plugins/amp-bridge-spike.ts

# Type-checking only for the Amp plugin; nothing here ships.
amp-bridge/plugin/node_modules/
